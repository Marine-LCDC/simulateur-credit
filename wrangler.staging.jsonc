{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "simulateur-credit-staging",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "vars": {
    "APP_ID": "simulation-credit",
    "TITAYLA_URL": "https://simulateur-credit-recette-auth.small-queen-a4c0.workers.dev"
  }
}
