{
  "name": "simulateur-credit",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/test-credit.mjs scripts/test-access.mjs scripts/test-migration.mjs",
    "test:worker": "node scripts/test-worker.mjs",
