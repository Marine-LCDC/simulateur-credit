    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.8"
  },
  "devDependencies": {
    "vite": "8.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "5.9.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/node": "24.10.0",
    "wrangler": "4.136.3",
    "@playwright/test": "1.63.0"
  }
}
