{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "simulateur-credit",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-23",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "simulateur-credit.titayla.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "vars": {
    "APP_ID": "simulation-credit",
    "TITAYLA_URL": "https://titayla.com"
  }
}
